// SQLite works out of the box (file lives next to the app).
// On Hostinger you can switch to the included MySQL database:
//   1. change provider below to "mysql"
//   2. set DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"
//   3. run `npx prisma db push`
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  name             String
  passwordHash     String
  stripeCustomerId String?        @unique
  createdAt        DateTime       @default(now())
  orders           Order[]
  consultations    Consultation[]
}

model Order {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  stripeSessionId String   @unique
  // pending | paid | failed | expired
  status          String   @default("pending")
  currency        String   @default("usd")
  amountSubtotal  Int      @default(0)
  amountTax       Int      @default(0)
  amountShipping  Int      @default(0)
  amountTotal     Int      @default(0)
  // JSON string: [{ productId, name, size, quantity, unitAmount }]
  items           String
  invoiceId       String?
  invoiceUrl      String?
  invoicePdf      String?
  shippingName    String?
  shippingAddress String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Consultation {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  email           String
  name            String
  preferredDate   String
  notes           String?
  // requested | invoiced | paid | void
  status          String   @default("requested")
  stripeInvoiceId String?  @unique
  invoiceUrl      String?
  amount          Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
