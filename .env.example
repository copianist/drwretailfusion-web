# Public URL of the site (used for Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Database — SQLite file by default. For Hostinger MySQL see prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Long random string used to sign login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Comma-separated emails that get the /admin dashboard
ADMIN_EMAILS="owner@drwretailfusion.com"

# Stripe — use a sandbox key while developing. Prefer a RESTRICTED key (rk_...)
# with write access to: Checkout Sessions, Customers, Invoices, Invoice Items,
# Products, Prices; read access to Tax Settings / Tax Registrations.
STRIPE_SECRET_KEY="rk_test_..."
# From `stripe listen` (local) or Dashboard > Developers > Webhooks (production)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Tax product tax codes. Pick exact codes from https://docs.stripe.com/tax/tax-codes
# (search "clothing" and "personal services"). Leave blank to use the preset
# tax code set in Dashboard > Tax > Settings.
STRIPE_TAX_CODE_APPAREL=""
STRIPE_TAX_CODE_STYLING=""

# Flat shipping in cents (0 = complimentary)
SHIPPING_FLAT_CENTS="0"
# Price of a one-on-one styling consultation, in cents
STYLING_CONSULTATION_CENTS="25000"
